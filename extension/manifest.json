{
  "manifest_version": 3,
  "name": "Category Filter for Twitch",
  "version": "0.1.0",
  "description": "Shows how many viewers each Twitch browse category has within your language and tag filters, and can hide categories with no matches.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Category Filter for Twitch settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.twitch.tv/*", "https://id.twitch.tv/*"],
  "background": { "service_worker": "src/background.js" },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
